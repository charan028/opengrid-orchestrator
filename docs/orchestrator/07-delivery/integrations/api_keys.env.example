# OpenGrid Orchestrator: integration secrets template.
# Copy to /etc/opengrid/api_keys.env (owner root:opengrid, mode 640). Never commit real values.
# ALWAYS single-quote values. Passwords often contain shell-special characters ($ \ ` ! spaces) that bash
# sourcing would otherwise alter. Single quotes are read literally by both bash and systemd EnvironmentFile.
# A value must not itself contain a single quote.

# --- ERCOT Public API (https://apiexplorer.ercot.com)
ERCOT_API_USER='<account email>'
ERCOT_API_PASSWORD='<account password>'
ERCOT_PUBLIC_API_KEY_PRIMARY='<Public API subscription key, primary>'
ERCOT_PUBLIC_API_KEY_SECONDARY='<Public API subscription key, secondary>'

# --- EIA Open Data v2 (https://www.eia.gov/opendata/register.php)
EIA_API_KEY='<EIA API key>'

# --- Reserved for later releases (leave empty if not provisioned)
ERCOT_STORAGE_API_KEY_PRIMARY=''
ERCOT_STORAGE_API_KEY_SECONDARY=''
MISO_API_USER=''
MISO_API_PASSWORD=''
