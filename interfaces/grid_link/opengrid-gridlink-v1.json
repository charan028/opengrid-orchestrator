{
  "layout": "opengrid-gridlink-v1",
  "protocol": "DNP3 (IEEE 1815-2012) over TCP, TLS 1.2+ with mutual authentication (IEC 62351-3 profile)",
  "roles": {
    "outstation": "OpenGrid orchestrator (og-engine grid-link task)",
    "master": "utility EMS / control centre (Austin Energy first); ogsim.utility_aen and ogsim.scada in test"
  },
  "description": "Point list of the utility grid-control link. Both sides hard-code these indices and each side has a test asserting its constants equal this file. Protocol-neutral meaning is in docs/orchestrator/07-delivery/integrations/grid-link.md; an ICCP bilateral table maps the same roles onto data values.",
  "control_status_codes": {
    "SUCCESS": 0,
    "TIMEOUT": 1,
    "NO_SELECT": 2,
    "FORMAT_ERROR": 3,
    "NOT_SUPPORTED": 4,
    "NOT_AUTHORIZED": 9,
    "AUTOMATION_INHIBIT": 10,
    "OUT_OF_RANGE": 12
  },
  "crob_codes": {
    "on": [1, 3, 65],
    "off": [2, 4, 129]
  },
  "analog_outputs": {
    "object": "g41v1 (int32) or g41v2 (int16) or g41v3 (float32); qualifier 0x17 or 0x28",
    "fixed": {
      "CALL_SETPOINT_KW": 0,
      "CALL_DURATION_MIN": 1,
      "CALL_ID": 2
    },
    "per_target": {
      "base": 16,
      "stride": 1,
      "roles": ["L2_LIMIT_KW"]
    }
  },
  "binary_outputs": {
    "object": "g12v1 CROB; SELECT/OPERATE or DIRECT_OPERATE; qualifier 0x17 or 0x28",
    "fixed": {
      "CALL_EXECUTE": 0,
      "CALL_CANCEL": 1,
      "HEARTBEAT": 2
    },
    "per_target": {
      "base": 16,
      "stride": 2,
      "roles": ["L2_LIMIT_ACTIVE", "L2_BLOCK"]
    }
  },
  "analog_inputs": {
    "object": "g30v5 (float32 with flags) for class 0; g30v1 (int32, rounded) when asked for",
    "fixed": {
      "AVAILABLE_KW": 0,
      "DELIVERED_KW": 1,
      "CALL_STATE": 2,
      "CALL_ID": 3,
      "CALL_REASON": 4,
      "CALL_DELIVERED_KW": 5,
      "SOC_PCT": 6,
      "HEARTBEAT_COUNT": 7
    },
    "per_target": {
      "base": 16,
      "stride": 1,
      "roles": ["L2_LIMIT_KW_ECHO"]
    },
    "per_bank": {
      "base": 100,
      "stride": 4,
      "roles": ["BANK_SOC_PCT", "BANK_AVAILABLE_KW", "BANK_DELIVERED_KW", "BANK_L2_CEILING_KW"]
    }
  },
  "binary_inputs": {
    "object": "g1v2 (with flags)",
    "fixed": {
      "LINK_HEALTHY": 0,
      "CALL_ACTIVE": 1,
      "ALARM_HEARTBEAT_LOST": 2,
      "ALARM_CALL_REJECTED": 3,
      "ALARM_TELEMETRY_STALE": 4,
      "ALARM_L2_ACTIVE": 5,
      "TOLL_CALLS_ENABLED": 6
    },
    "per_target": {
      "base": 16,
      "stride": 2,
      "roles": ["L2_LIMIT_ACTIVE_ECHO", "L2_BLOCK_ECHO"]
    }
  },
  "call_state_codes": {
    "IDLE": 0,
    "ACCEPTED": 1,
    "ACTIVE": 2,
    "ENDED": 3,
    "REJECTED": 4
  },
  "call_reason_codes": {
    "NONE": 0,
    "R-CALL-NOT-FOUND": 1,
    "R-CALL-NOT-DEPLOYABLE": 2,
    "R-CALL-STATE": 3,
    "R-CALL-NO-PRODUCT-DURATION": 4,
    "R-CALL-DURATION-CAP": 5,
    "R-CALL-OVERLAP": 6,
    "R-CALL-CHARGE-REFUSED": 7,
    "R-CALL-OVER-COMMITTED": 8,
    "R-CALL-OUTSIDE-WINDOW": 9,
    "R-CALL-IDEMPOTENCY-CONFLICT": 10,
    "R-CALL-RATE-LIMIT": 11,
    "R-CALL-FLEET-WIDE": 12,
    "R-GL-LINK-DOWN": 50,
    "R-GL-CORE-TIMEOUT": 51,
    "R-GL-INTERNAL": 52,
    "UNKNOWN": 99
  },
  "limits": {
    "max_targets": 64,
    "max_banks": 200,
    "no_l2_ceiling": -1
  }
}
