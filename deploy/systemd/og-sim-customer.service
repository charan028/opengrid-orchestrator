[Unit]
Description=OpenGrid integration-sims - customer-operator simulators
After=network.target mosquitto.service
Requires=mosquitto.service
PartOf=ogsim.target

[Service]
Type=simple
User=opengrid
Group=opengrid
WorkingDirectory=/opt/opengrid/current/integration-sims
Environment=PYTHONPATH=/opt/opengrid/current/integration-sims/src
# Production marker: ogsim.common.config refuses the production topic root (og/v1) without it.
Environment=OGSIM_ENV=prod
EnvironmentFile=/etc/opengrid/secrets.env
# OGSIM_CUSTOMER_API_BASE and the per-group OGSIM_CUSTOMER_<DC|PIPE|ERCOT|DIST|PARTNER>_USER/
# _PASSWORD Apache basic-auth credentials (0640 root:opengrid) -- never sourced from
# secrets.env, and never logged by ogsim.customer.
EnvironmentFile=/etc/opengrid/customer_sim.env
ExecStart=/opt/ogsim/venv/bin/python -m ogsim.customer
Restart=always
RestartSec=2
MemoryMax=256M
MemoryHigh=192M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opengrid /var/log/opengrid
PrivateTmp=true

[Install]
WantedBy=multi-user.target
