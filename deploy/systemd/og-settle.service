[Unit]
Description=OpenGrid Orchestrator - settle
After=network.target postgresql.service mosquitto.service
Requires=postgresql.service mosquitto.service
PartOf=opengrid.target

[Service]
# Production wins disk contention over agent test runs and the lifecycle job.
IOWeight=500
Type=simple
User=opengrid
Group=opengrid
WorkingDirectory=/opt/opengrid/current/orchestrator
Environment=PYTHONPATH=/opt/opengrid/current/orchestrator/src
Environment=OG_CONFIG=/opt/opengrid/current/orchestrator/config/orchestrator.toml
EnvironmentFile=/etc/opengrid/secrets.env
EnvironmentFile=/etc/opengrid/api_keys.env
ExecStart=/opt/opengrid/venv/bin/python -m opengrid.settle.main
Restart=always
RestartSec=2
MemoryMax=512M
MemoryHigh=410M
NoNewPrivileges=true
ProtectSystem=strict
# '-': optional. The anchors dir is created by deploy.sh; a host without /srv/ogbackup still starts og-settle
# (anchors then publish to the primary [trace].anchor_dir only).
ReadWritePaths=/var/lib/opengrid /var/log/opengrid -/srv/ogbackup/anchors
PrivateTmp=true

[Install]
WantedBy=multi-user.target
