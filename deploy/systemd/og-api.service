[Unit]
Description=OpenGrid Orchestrator - api
After=network.target postgresql.service mosquitto.service
Requires=postgresql.service mosquitto.service
PartOf=opengrid.target

[Service]
# Production wins disk contention over agent test runs and the lifecycle job.
IOWeight=500
Type=simple
User=opengrid
Group=opengrid
WorkingDirectory=/opt/opengrid/current/orchestrator
Environment=PYTHONPATH=/opt/opengrid/current/orchestrator/src
Environment=OG_CONFIG=/opt/opengrid/current/orchestrator/config/orchestrator.toml
EnvironmentFile=/etc/opengrid/secrets.env
EnvironmentFile=/etc/opengrid/api_keys.env
# AI copilot key (optional: without it the copilot runs its no-model tier).
EnvironmentFile=-/etc/opengrid/ai_agent.env
# og-api only (never secrets.env, which the sims load): the Apache proxy secret.
EnvironmentFile=/etc/opengrid/api_proxy.env
ExecStart=/opt/opengrid/venv/bin/python -m opengrid.api
Restart=always
RestartSec=2
MemoryMax=1G
MemoryHigh=819M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opengrid /var/log/opengrid
PrivateTmp=true

[Install]
WantedBy=multi-user.target
