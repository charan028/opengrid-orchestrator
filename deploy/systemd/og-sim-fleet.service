[Unit]
Description=OpenGrid integration-sims - fleet (2,000 simulated hubs + bank aggregators)
After=network.target mosquitto.service
Requires=mosquitto.service
PartOf=ogsim.target

[Service]
Type=simple
User=opengrid
Group=opengrid
WorkingDirectory=/opt/opengrid/current/integration-sims
Environment=PYTHONPATH=/opt/opengrid/current/integration-sims/src
EnvironmentFile=/etc/opengrid/secrets.env
ExecStart=/opt/ogsim/venv/bin/python -m ogsim.fleet
Restart=always
RestartSec=2
MemoryMax=3G
MemoryHigh=2458M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opengrid /var/log/opengrid
PrivateTmp=true

[Install]
WantedBy=multi-user.target
