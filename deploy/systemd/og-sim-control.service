[Unit]
Description=OpenGrid integration-sims - control (ogsim.control: REST + web UI + CLI, scenario injection)
After=network.target mosquitto.service
Requires=mosquitto.service
PartOf=ogsim.target

[Service]
Type=simple
User=opengrid
Group=opengrid
WorkingDirectory=/opt/opengrid/current/integration-sims
Environment=PYTHONPATH=/opt/opengrid/current/integration-sims/src
EnvironmentFile=/etc/opengrid/secrets.env
ExecStart=/opt/ogsim/venv/bin/python -m ogsim.control
Restart=always
RestartSec=2
MemoryMax=256M
MemoryHigh=205M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opengrid /var/log/opengrid
PrivateTmp=true

[Install]
WantedBy=multi-user.target
