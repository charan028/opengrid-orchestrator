# dev/secrets.example -- the variable NAMES the local docker compose stack needs. No values: this
# repository never holds credentials. `make dev-up` copies this file to `dev/secrets` (gitignored);
# fill in your own local-only values there before bringing the stack up. Loaded into postgres,
# mosquitto-init, migrate, the sims and the orchestrator profile via `env_file:` in
# dev/docker-compose.yml.

# --- Postgres (the container reads POSTGRES_PASSWORD; the orchestrator reads OG_DB_PASSWORD;
# set both to the same value) ---
POSTGRES_PASSWORD=
OG_DB_PASSWORD=

# --- Mosquitto: one user per role (dev/scripts/gen-mosquitto-passwd.sh hashes these) ---
OG_MQTT_SIM_PASSWORD=
OG_MQTT_SIMCTL_PASSWORD=
OG_MQTT_ENGINE_PASSWORD=
OG_MQTT_GUARDIAN_PASSWORD=
OG_MQTT_SAFESTOP_PASSWORD=
OG_MQTT_API_PASSWORD=

# --- og-api identity proxy (orchestrator profile only): opengrid.api.auth trusts X-Remote-User
# only alongside this shared secret in X-OG-Proxy-Auth (production: Apache sets both; dev: any
# local value works, tests-e2e/functional/e2e_stack.py reads it from this file automatically) ---
OG_API_PROXY_SECRET=

# --- og-feeds ERCOT/EIA credentials (orchestrator profile only): these authenticate against
# sim-market's stand-in endpoints (dev/config/docker.toml's feeds.ercot.token_url), never the
# real ERCOT/EIA services -- values must match ogsim.market.config.MarketConfig's test defaults
# (integration-sims/src/ogsim/market/config.py) unless OGSIM_MARKET_TEST_USERS/KEY_PRIMARY/
# KEY_SECONDARY/EIA_API_KEY override them on sim-market ---
ERCOT_API_USER=
ERCOT_API_PASSWORD=
ERCOT_PUBLIC_API_KEY_PRIMARY=
ERCOT_PUBLIC_API_KEY_SECONDARY=
EIA_API_KEY=
