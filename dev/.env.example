# dev/.env.example -- DEV-ONLY placeholder values. NEVER production values.
#
# Copy to `dev/.env` (gitignored; docker compose auto-loads a `.env` next to
# docker-compose.yml). `dev/.env` covers compose-level settings (ports, image
# tags, fleet size); MQTT/Postgres passwords live in `dev/secrets` (see
# `dev/secrets.example`) and are loaded into the relevant services via
# `env_file:` in docker-compose.yml, not duplicated here.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=opengrid
POSTGRES_DB=og

# --- Published ports (host:container) -- change if something else on your
# machine already uses one of these --------------------------------------
POSTGRES_PORT=5432
MOSQUITTO_PORT=1883
MARKET_SIM_PORT=8090
CONTROL_SIM_PORT=8091

# --- Fleet size -------------------------------------------------------------
# 200 hubs / 8 banks by default so the stack runs comfortably on a laptop
# (BUILD.md WP D0). Bump toward production (2000/40) only if your machine
# has the RAM/CPU for it -- see dev/config/fleet.dev.yaml and
# dev/config/scada.dev.yaml, which must both change together, plus
# dev/config/dev.toml's [fleet] section for consistency.
FLEET_HUB_COUNT=200
FLEET_BANK_COUNT=8

# --- Market simulator data mode ---------------------------------------------
# "synthetic" needs no historical data file and is the default for a fresh
# checkout; "replay" requires OGSIM_MARKET_HISTORY_PATH to point at a real
# mariadb_history_signals.tsv export, which most contributors won't have.
MARKET_DATA_MODE=synthetic
