# OpenGrid Orchestrator: every environment variable in one place, with placeholder values.
# The dev stack reads dev/.env and dev/secrets (copied from their .example files by `make -C dev dev-up-full`);
# production reads /etc/opengrid/*.env. Nothing here is a real value. Never commit a filled-in copy.

# --- Local stack (dev/.env.example) ---------------------------------------------------------------
POSTGRES_USER=opengrid
POSTGRES_DB=og
POSTGRES_PORT=5432
MOSQUITTO_PORT=1883
MARKET_SIM_PORT=8090
CONTROL_SIM_PORT=8091
API_PORT=8080
FLEET_HUB_COUNT=200
FLEET_BANK_COUNT=8
MARKET_DATA_MODE=synthetic            # synthetic | replay (replay needs OGSIM_MARKET_HISTORY_PATH)

# --- Local secrets (dev/secrets.example; dev-only placeholders) ----------------------------------
OG_DB_PASSWORD=change-me
OG_MQTT_ENGINE_PASSWORD=change-me
OG_MQTT_GUARDIAN_PASSWORD=change-me
OG_MQTT_SAFESTOP_PASSWORD=change-me
OG_MQTT_API_PASSWORD=change-me
OG_MQTT_SIM_PASSWORD=change-me
OG_MQTT_SIMCTL_PASSWORD=change-me
OG_API_PROXY_SECRET=dev-proxy-secret  # must match between the proxy (Apache or dev/scripts/dev_proxy.py) and og-api

# --- Which config each process loads --------------------------------------------------------------
OG_CONFIG=dev/config/dev.toml
OG_AUTHZ_POLICY=orchestrator/config/authz.toml

# --- Live market feeds (docs/orchestrator/07-delivery/integrations/api_keys.env.example); optional ------
ERCOT_API_USER=
ERCOT_API_PASSWORD=
ERCOT_PUBLIC_API_KEY_PRIMARY=
ERCOT_PUBLIC_API_KEY_SECONDARY=
EIA_API_KEY=

# --- The advisory copilot; optional. Without keys it answers from console data only and says so -----
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
